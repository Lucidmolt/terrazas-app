// ── Prisma Schema for Terrazas.app ──────────────────────────────────
// PostgreSQL on Supabase. Uses connection pooler (pgbouncer) for queries
// and direct connection for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users ───────────────────────────────────────────────────────────
model User {
  id          String   @id @default(cuid())
  supabaseId  String?  @unique // Supabase Auth UID — links auth to our DB
  email       String?  @unique
  phone       String?  @unique
  name        String?
  avatarUrl   String?
  role        String   @default("customer") // "customer" | "pro" | "admin"

  // ── Profile Fields ──
  address     String?
  city        String?
  state       String?
  zipCode     String?
  latitude    Float?   // Home location for distance calculations
  longitude   Float?

  // ── Account Status ──
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  onboardedAt    DateTime? // When they completed onboarding
  tosAcceptedAt  DateTime? // When they accepted Terms of Service
  tosVersion     String?   // Which TOS version they accepted
  economyAckedAt DateTime? // One-time Community Pro tier acknowledgment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  provider              Provider?
  jobsAsCustomer        Job[]                  @relation("CustomerJobs")
  reviewsGiven          Review[]               @relation("ReviewAuthor")
  tipsGiven             Tip[]                  @relation("TipGiver")
  notifications         Notification[]
  notificationPrefs     NotificationPreference?
  sentMessages          Message[]              @relation("SentMessages")
  pushSubscriptions     PushSubscription[]
}

// ── Providers (Pro Profiles) ────────────────────────────────────────
model Provider {
  id              String   @id @default(cuid())
  userId          String   @unique
  businessName    String
  phone           String?
  email           String?
  googlePlaceId   String?
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  serviceTypes    String   @default("[]") // JSON array of service types
  zipCodes        String   @default("[]") // JSON array of zip codes served
  latitude        Float?   // Provider home base lat
  longitude       Float?   // Provider home base lng
  serviceRadiusMi Float    @default(20) // Max service radius in miles
  stripeAccountId String?                 // Stripe Connect ID
  insuranceStatus String   @default("pending") // pending | verified | flagged
  riskTier        Int      @default(1)
  avatarUrl       String?

  // ── Profile (customer-facing) ──
  logoUrl          String?  // Business logo
  bio              String?  // About the business (min 150 chars)
  portfolioPhotos  String   @default("[]") // JSON array of photo URLs
  yearsInBusiness  Int?     // Self-reported
  teamSize         String?  // "solo" | "small" | "medium"
  equipmentType    String?  // "residential" | "commercial"
  profileStatus    String   @default("draft") // draft | pending_review | verified | rejected
  rejectionReason  String?  // Why admin rejected

  // ── Veto Tracking ──
  vetoCount        Int      @default(0) // Rolling veto count (resets weekly)
  lastVetoAt       DateTime?

  // ── Gig-Tier (Community Pro) ──
  proTier          Int      @default(0) // 0=community, 1=verified
  equipmentPhotoUrl String?             // Photo of mowing equipment
  equipmentTag     String?              // AI-tagged: "push_mower" | "riding_mower" | "commercial"
  completedJobCount Int     @default(0) // Lifetime completed jobs
  upgradeEligible  Boolean  @default(false) // 20+ jobs at 4.8+ rating
  upgradeOfferedAt DateTime?            // When upgrade was offered
  escrowBalance    Float    @default(0) // Held escrow for damage protection
  escrowHoldPct    Float    @default(0.05) // 5% hold on first 10 payouts
  idVerified       Boolean  @default(false) // Identity verified
  maxActiveJobs    Int      @default(2) // Community=2, Verified=unlimited

  // ── Payout Info ──
  bankLinked      Boolean  @default(false)
  totalEarnings   Float    @default(0) // Lifetime earnings
  pendingPayout   Float    @default(0) // Unpaid balance
  availablePayout Float    @default(0) // Cleared funds (past hold period)
  payoutSchedule  String   @default("weekly") // weekly (all tiers)
  payoutHoldDays  Int      @default(3) // Community=3, Verified=1
  instantPayoutFee Float   @default(1.99) // Fee for instant payout (Community only)
  freeInstant     Boolean  @default(false) // Verified Pros get free instant
  lastPayoutAt    DateTime? // When last payout was processed
  lifetimeInstantFees Float @default(0) // Total instant payout fees collected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs     Job[]    @relation("ProviderJobs")
  claims   Claim[]
  reviews  Review[] @relation("ReviewSubject")
  tips     Tip[]    @relation("TipReceiver")
  vetosReceived Veto[] @relation("VetoedProvider")
  announcements NeighborhoodAnnouncement[]
}

// ── Jobs ────────────────────────────────────────────────────────────
model Job {
  id               String    @id @default(cuid())
  customerId       String
  providerId       String?
  status           String    @default("broadcast")
  // broadcast → pending_claim → active → en_route → in_progress → completed | cancelled
  serviceType      String    @default("mowing")
  tier             String    @default("basic") // basic | premium
  zipCode          String
  address          String    @default("")
  latitude         Float?    // Job location lat
  longitude        Float?    // Job location lng
  placeId          String?   // Google Place ID for the address

  // ── Dynamic Pricing Fields ──
  scope            String    @default("front_back") // front_only | back_only | front_back | full_property
  lotSize          String    @default("medium")     // small | medium | large | xl
  urgency          String    @default("same_day")   // scheduled | same_day | asap
  conditionScore   Float?    // 1-10 from AI vision
  conditionGrade   String?   // pristine | good | average | overgrown | neglected
  extras           String    @default("[]") // JSON array of extra keys

  // ── Pricing Breakdown (stored at time of creation) ──
  basePrice        Float     @default(45.0)
  scopeMultiplier  Float     @default(1.0)
  conditionMult    Float     @default(1.0)
  demandMultiplier Float     @default(1.0)
  lotSizeMultiplier Float    @default(1.0)
  urgencyMultiplier Float    @default(1.0)
  price            Float     @default(45.0)   // Final job price after multipliers
  serviceFee       Float     @default(0)      // Platform service fee charged
  processingFee    Float     @default(2.50)   // Processing fee charged
  extrasTotal      Float     @default(0)      // Total from extras
  customerTotal    Float     @default(0)      // Total charged to customer
  providerPayout   Float     @default(0)      // Amount provider receives
  paymentIntentId  String?   // Stripe PaymentIntent ID

  // ── Photos (required for job posting) ──
  photoFrontUrl    String?   // Front yard photo (required)
  photoBackUrl     String?   // Back yard photo (required if back selected)
  photoExtraUrl    String?   // Optional third photo
  photoAfterUrl    String?   // Provider uploads after completion

  // ── AI Vision ──
  conditionNotes   String?   // Yard Vision AI output
  aiWarning        Boolean   @default(false)
  aiProvider       String?   // "local" | "cloud" — which AI assessed it

  // ── Status Tracking ──
  etaMinutes       Int?
  pendingProId     String?
  customerNotes    String?   // Special instructions from customer
  surgeLevel       String?   // low | normal | busy | high | peak | parachute

  // ── Gig-Tier Visibility ──
  minProTier       Int       @default(0) // 0=any pro, 1=verified only
  complexityFlags  String    @default("[]") // JSON: ["pool","steep","expensive_landscaping"]
  terrainType      String    @default("flat") // flat | sloped | steep
  lotSqFt          Int?      // Lot size in square feet (for gig-tier cap)
  economyRate      Boolean   @default(false) // Customer opted for economy pricing

  // ── Broadcast Escalation (System 2: Time Dilation) ──
  broadcastTier    Int       @default(1)  // 0=preferred, 1=local_zip, 2=global
  escalatedAt      DateTime?              // When last escalation occurred
  preferredProId   String?                // Customer's preferred provider (tier 0)
  quotedPrice      Float?                 // Temporary custom quote price from claiming pro


  // ── Veto / Approval ──
  blockedProviders String    @default("[]") // JSON array of vetoed provider IDs
  vetoCount        Int       @default(0)    // How many vetos on this job
  vetoReasons      String    @default("[]") // JSON array of veto reasons for analytics
  approvalDeadline DateTime? // claim time + 10 min (auto-approve if not acted on)
  autoApproved     Boolean   @default(false)

  broadcastedAt    DateTime? // When the job was sent to providers
  claimedAt        DateTime?
  approvedAt       DateTime? // When customer approved (or auto-approved)
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Telemetry Coordinates
  providerLocLat   Float?    // Live provider latitude tracking
  providerLocLng   Float?    // Live provider longitude tracking

  // Disputes
  disputedAt       DateTime?
  disputeReason    String?
  disputePhotoUrl  String?
  disputeStatus    String?   // pending | resolved_refunded | resolved_rejected

  // Relations
  customer      User           @relation("CustomerJobs", fields: [customerId], references: [id])
  provider      Provider?      @relation("ProviderJobs", fields: [providerId], references: [id])
  claims        Claim[]
  review        Review?
  tip           Tip?
  notifications Notification[]
  vetos         Veto[]
  messages      Message[]
}

// ── Claims (The "Race") ─────────────────────────────────────────────
model Claim {
  id            String   @id @default(cuid())
  jobId         String
  providerId    String
  etaMinutes    Int      @default(30)
  wasSuccessful Boolean  @default(false)
  attemptedAt   DateTime @default(now())

  // Relations
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])
}

// ── Vetos (Customer rejections of providers) ────────────────────────
model Veto {
  id         String   @id @default(cuid())
  jobId      String
  providerId String   // Who was vetoed
  customerId String   // Who vetoed them
  reason     String?  // Optional: "low_rating" | "no_portfolio" | "prefer_other" | "long_eta" | "other"
  createdAt  DateTime @default(now())

  // Relations
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider Provider @relation("VetoedProvider", fields: [providerId], references: [id])

  @@index([providerId])
  @@index([jobId])
}

// ── Reviews ─────────────────────────────────────────────────────────
model Review {
  id         String   @id @default(cuid())
  jobId      String   @unique
  authorId   String
  providerId String
  rating     Int      // 1-5
  comment    String?
  photoUrl   String?
  createdAt  DateTime @default(now())

  // Relations
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  provider Provider @relation("ReviewSubject", fields: [providerId], references: [id])
}

// ── Tips ─────────────────────────────────────────────────────────────
model Tip {
  id                String   @id @default(cuid())
  jobId             String   @unique
  customerId        String
  providerId        String
  amount            Float    // Tip amount in dollars
  stripePaymentId   String?  // Stripe PaymentIntent ID
  status            String   @default("pending") // pending | processing | completed | failed
  createdAt         DateTime @default(now())

  // Relations
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer User     @relation("TipGiver", fields: [customerId], references: [id])
  provider Provider @relation("TipReceiver", fields: [providerId], references: [id])
}

// ── Notifications ───────────────────────────────────────────────────
// Stores every alert sent to users (for audit trail + in-app inbox)
model Notification {
  id          String   @id @default(cuid())
  userId      String
  jobId       String?  // Related job, if applicable
  type        String   // "job_broadcast" | "job_claimed" | "job_completed" | "payment" | "review" | "system"
  channel     String   // "email" | "sms" | "push" | "in_app"
  title       String
  body        String
  isRead      Boolean  @default(false)
  isSent      Boolean  @default(false) // Whether the external notification was delivered
  sentAt      DateTime?
  readAt      DateTime?
  metadata    String?  // JSON blob for extra context (jobPrice, providerName, etc.)
  createdAt   DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, type])
}

// ── Notification Preferences ────────────────────────────────────────
// Per-user settings for how they want to be alerted
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  // Channel toggles
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false) // Requires verified phone
  pushEnabled  Boolean @default(false) // Requires PWA subscription

  // What to notify about
  jobBroadcast   Boolean @default(true)  // New jobs in your area
  jobClaimed     Boolean @default(true)  // Your job was claimed
  jobCompleted   Boolean @default(true)  // Job marked complete
  paymentReceived Boolean @default(true) // Payment processed
  reviewReceived Boolean @default(true)  // New review on your profile
  marketing      Boolean @default(false) // Promotions & updates

  // Quiet hours (provider-side)
  quietStart String? // "22:00" — don't send between these
  quietEnd   String? // "07:00"

  // WebPush subscription (System 4)
  pushSubscription String? // JSON-stringified PushSubscription object

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Yard Vision Scans ───────────────────────────────────────────────
model YardScan {
  id              String   @id @default(cuid())
  jobId           String?
  imageUrl        String   // Path to uploaded image
  provider        String   @default("local") // "local" | "cloud"
  modelUsed       String?  // e.g. "llava:13b" or "claude-sonnet-4-20250514"
  conditionScore  Float?   // 1-10 condition rating
  estimatedEffort String?  // "low" | "medium" | "high" | "extreme"
  findings        String?  // JSON string of detected issues
  rawResponse     String?  // Full AI response for debugging
  processingMs    Int?     // How long the scan took
  createdAt       DateTime @default(now())
}

// ── Escrow Holds (Gig-Tier Protection Fund) ─────────────────────────
// Withheld portion of Community Pro payouts for damage coverage
model EscrowHold {
  id          String   @id @default(cuid())
  providerId  String
  jobId       String
  amount      Float    // Dollars withheld from this payout
  status      String   @default("held") // held | released | claimed
  reason      String?  // If claimed: what the damage was
  releasedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([providerId, status])
}

// ── Payout Records (Audit Trail) ────────────────────────────────────
// Every payout event: weekly batch or instant on-demand
model PayoutRecord {
  id              String   @id @default(cuid())
  providerId      String
  type            String   // "weekly" | "instant"
  grossAmount     Float    // Total before fees
  escrowHeld      Float    @default(0) // Escrow deducted
  instantFee      Float    @default(0) // $1.99 fee for instant (Community)
  netAmount       Float    // What actually gets paid out
  stripeTransferId String? // Stripe transfer ID
  status          String   @default("pending") // pending | processing | completed | failed
  failureReason   String?  // If failed
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([providerId, createdAt])
  @@index([status])
}

// ── Message (Chat Room per Job) ─────────────────────────────────────
model Message {
  id        String   @id @default(cuid())
  jobId     String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)

  // Relations
  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

// ── Neighborhood Availability Announcement ─────────────────────────
model NeighborhoodAnnouncement {
  id         String   @id @default(cuid())
  providerId String
  zipCode    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([zipCode, expiresAt])
}

// ── Web Push Subscriptions ──────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  auth      String
  p256dh    String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

